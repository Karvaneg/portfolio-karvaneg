# URL publique du site (utilisée pour les metadata / Open Graph / sitemap).
# En prod : l'URL Vercel ou le domaine custom. Sans slash final.
NEXT_PUBLIC_SITE_URL=https://portfolio-karvaneg.vercel.app

# URL locale de dev (optionnelle).
NEXT_LOCAL_SITE_URL=http://localhost:3000

# Secrets Vercel (CI uniquement, ne PAS committer les vraies valeurs) :
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
