# URL publique du site (utilisée pour les metadata / Open Graph / sitemap).
# En prod : l'URL Vercel ou le domaine custom. Sans slash final.
NEXT_PUBLIC_SITE_URL=https://portfolio-karvaneg.vercel.app

# URL locale de dev (optionnelle).
NEXT_LOCAL_SITE_URL=http://localhost:3000

# Secrets Vercel (CI uniquement, ne PAS committer les vraies valeurs) :
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Token GitHub (lecture seule) pour les stats du repo open source (carnet technique).
# Sans lui : API non authentifiée, 60 req/h par IP → souvent rate-limitée au build
# (Vercel) → la section retombe sur le snapshot FALLBACK. Avec lui : 5 000 req/h →
# vraies valeurs au build/ISR. Scope minimal : « public_repo » (classic) ou
# fine-grained « Contents: read ». Variable serveur, jamais exposée au client.
# GITHUB_TOKEN_PORTFOLIO=
